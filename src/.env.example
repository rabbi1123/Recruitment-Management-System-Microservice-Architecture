# Database password (required for local run and Docker).
# Copy to src/.env and set your value: cp .env.example .env
Candidate_DB_PASSWORD=YourStrong!Passw0rd

# SA password for the Organization SQL Server container.
Organization_DB_PASSWORD=YourStrong!Passw0rd

# SA password for the Job SQL Server container.
Job_DB_PASSWORD=YourStrong!Passw0rd

# SA password for the Recruitment SQL Server container.
Recruitment_DB_PASSWORD=YourStrong!Passw0rd

# SA password for the Identity SQL Server container.
Identity_DB_PASSWORD=YourStrong!Passw0rd

# Optional: override JWT signing key in Docker/production (maps to JwtSettings__Key).
# JWT_KEY=your-production-signing-key-at-least-32-characters
